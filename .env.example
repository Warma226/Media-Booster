# Réglages de la plateforme Media Booster (Vercel › Settings › Environment Variables).
# Ce sont TES clés de propriétaire de la plateforme : tes clients n'en voient aucune.

# ─── Indispensables ──────────────────────────────────────────────────
# Longue chaîne aléatoire (40 caractères ou plus) : signe les sessions et les liens. La changer déconnecte tout le monde.
APP_SECRET=
# Base de données Supabase (Project Settings › API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Clé des tâches planifiées (veille, publications, NOVA) appelées toutes les 15 min
CRON_SECRET=
# Adresse publique de l'app (détectée automatiquement sur Vercel ; à renseigner avec un domaine personnalisé)
APP_URL=
# Ton e-mail (ou plusieurs, séparés par des virgules) : accès à la page Plateforme (tous les clients)
PLATEFORME_ADMINS=

# ─── IA (rédaction) : au moins une des deux ──────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Paiement des abonnements : CinetPay (compte marchand) ───────────
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# XOF (FCFA Afrique de l'Ouest) par défaut ; XAF pour l'Afrique centrale
CINETPAY_DEVISE=XOF

# ─── Facebook : app sur developers.facebook.com (type Entreprise) ────
META_APP_ID=
META_APP_SECRET=
# Facultatif : identifiant de configuration « Facebook Login for Business »
META_CONFIG_ID=
FB_GRAPH_VERSION=v21.0

# ─── LinkedIn : app sur linkedin.com/developers ──────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Mettre 1 quand LinkedIn a accordé l'accès « Community Management API » (pages entreprise)
LINKEDIN_PAGES=

# ─── TikTok (facultatif) : app sur developers.tiktok.com ─────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── Vidéos à reprendre (facultatif) : clé YouTube Data API ──────────
YOUTUBE_API_KEY=
